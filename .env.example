# Firebase Console > Project settings > Your apps > Web app configuration.
# These identify your project; security comes from Auth and Firestore Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# One agency ID, matching the owner-admin init/enroll commands.
VITE_AGENCY_ID=saman-indika
# Never put service-account keys, custom tokens, or PINs in VITE_ variables.
