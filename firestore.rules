rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DATA MODEL — Standard Firestore, integer LKR minor units.
    // agencies/{agency}: owner-created metadata, readable by enrolled devices.
    // devices/{uid}: {active:bool,label:string,createdAt:timestamp,revokedAt?:timestamp};
    //   PIN enrolment creates a membership with enrollment:'owner-pin'. Only the
    //   Admin SDK can modify or revoke an existing membership.
    // setup/window: public-to-signed-in setup ID and start time. setup/pinState:
    //   private salted verifier, attempt budget and three-device claim limit.
    // setupAttempts/{uid}: private proof linked to one committed attempt.
    // events/{id}: immutable domain event + authUid:string, serverSequence:int,
    //   disposition:'applied'|'conflict', conflictReason?:string. Daily sales
    //   events carry total:int and previousId:string with an empty shopId.
    //   operatorId identifies the recorded operator, not a Firebase identity.
    // sync/head: {sequence:int,lastEventId:string}, changed atomically with one
    //   newly created event. This serializes append operations across devices.
    // shops/{id}: validated shop profile with authUid and updatedAt audit fields.
    // closes/{id}: immutable first-close snapshot with authenticated device UID.
    // No derived financial balances are client-writable documents. The ledger
    // replays immutable sequenced events and independently rejects overpayments.
    // Clients cannot modify memberships, rewrite events, or delete history.

    function signedIn() { return request.auth != null; }
    function anonymousDevice() {
      return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }
    function devicePath(agency, uid) {
      return /databases/$(database)/documents/agencies/$(agency)/devices/$(uid);
    }
    function validMembership(agency, membership) {
      return membership.active == true
        && (request.auth.token.get('agencyId', '') == agency
          || (anonymousDevice() && membership.get('enrollment', '') == 'owner-pin'));
    }
    function enrolled(agency) {
      return signedIn()
        && exists(/databases/$(database)/documents/agencies/$(agency))
        && validMembership(agency, get(devicePath(agency, request.auth.uid)).data);
    }
    function text(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function id(value) { return text(value, 1, 120) && value.matches('^[A-Za-z0-9_-]+$'); }
    function money(value) { return value is int && value >= 0 && value <= 99999999999; }
    function positiveMoney(value) { return money(value) && value > 0; }
    function day(value) { return text(value, 10, 10) && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function instant(value) { return text(value, 20, 35) && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$'); }
    function optionalText(data, key, maximum) { return !(key in data) || text(data[key], 0, maximum); }
    function pinWindowPath(agency) {
      return /databases/$(database)/documents/agencies/$(agency)/setup/window;
    }
    function pinStatePath(agency) {
      return /databases/$(database)/documents/agencies/$(agency)/setup/pinState;
    }
    function pinAttemptPath(agency, uid) {
      return /databases/$(database)/documents/agencies/$(agency)/setupAttempts/$(uid);
    }
    function pinNonce(value) {
      return text(value, 32, 32) && value.matches('^[0-9a-f]+$');
    }
    function hexDigest(value) {
      return text(value, 64, 64) && value.matches('^[0-9a-f]+$');
    }
    function validPinWindow(data) {
      return data.keys().hasOnly(['id','openedAt'])
        && pinNonce(data.id)
        && data.openedAt == request.time;
    }
    function validNewPinState(data, windowId) {
      return data.keys().hasOnly(['id','digest','attempts','joined','lastUid','lastAttemptId'])
        && data.id == windowId && hexDigest(data.digest)
        && data.attempts is int && data.attempts == 0
        && data.joined is int && data.joined == 0 && data.lastUid == '' && data.lastAttemptId == '';
    }
    function pinWindowOpen(agency, state) {
      let window = get(pinWindowPath(agency)).data;
      return state.id == window.id && state.joined < 3
        && request.time < window.openedAt + duration.value(10, 'm');
    }
    function validPinAttemptData(attempt, state) {
      return attempt.keys().hasOnly(['windowId','nonce','proof','attemptedAt'])
        && attempt.windowId == state.id && attempt.nonce == state.lastAttemptId
        && hexDigest(attempt.proof) && attempt.attemptedAt == request.time;
    }
    function validNewPinAttempt(agency, before, after) {
      return anonymousDevice() && !exists(devicePath(agency, request.auth.uid))
        && pinWindowOpen(agency, before) && before.attempts - before.joined < 5
        && after.diff(before).affectedKeys().hasOnly(['attempts','lastUid','lastAttemptId'])
        && after.attempts is int && after.attempts == before.attempts + 1
        && after.lastUid == request.auth.uid && pinNonce(after.lastAttemptId)
        && after.lastAttemptId != before.lastAttemptId
        && validPinAttemptData(getAfter(pinAttemptPath(agency, request.auth.uid)).data, after);
    }
    function validPinClaim(agency, uid, before, after) {
      let attempt = get(pinAttemptPath(agency, uid)).data;
      return anonymousDevice() && pinWindowOpen(agency, before)
        && attempt.windowId == before.id && attempt.proof == before.digest
        && attempt.attemptedAt >= get(pinWindowPath(agency)).data.openedAt
        && after.diff(before).affectedKeys().hasOnly(['joined'])
        && after.joined is int && after.joined == before.joined + 1;
    }
    function attemptMatchesCounter(agency, uid, data) {
      let before = get(pinStatePath(agency)).data;
      let after = getAfter(pinStatePath(agency)).data;
      return after.attempts == before.attempts + 1 && after.lastUid == uid
        && validPinAttemptData(data, after);
    }
    function validPinMembership(data) {
      return data.keys().hasOnly(['active','label','createdAt','enrollment'])
        && data.active == true && data.label == 'Owner PIN device'
        && data.createdAt == request.time && data.enrollment == 'owner-pin';
    }
    function stringAt(list, index) { return list.size() <= index || id(list[index]); }
    function photoIds(value) {
      return value is list && value.size() <= 5
        && stringAt(value, 0) && stringAt(value, 1) && stringAt(value, 2)
        && stringAt(value, 3) && stringAt(value, 4);
    }
    function validCheque(data) {
      return data is map
        && data.keys().hasAll(['id','bank','number','amount','date','photoIds'])
        && data.keys().hasOnly(['id','bank','number','amount','date','photoIds'])
        && id(data.id) && text(data.bank, 1, 120) && text(data.number, 1, 80)
        && positiveMoney(data.amount) && day(data.date) && photoIds(data.photoIds);
    }
    function chequeAt(list, index) { return list.size() <= index || validCheque(list[index]); }
    function validCheques(value) {
      return value is list && value.size() <= 5
        && chequeAt(value, 0) && chequeAt(value, 1) && chequeAt(value, 2)
        && chequeAt(value, 3) && chequeAt(value, 4);
    }
    function validChequeAllocation(data) {
      return data is map && data.keys().hasAll(['chequeId','amount'])
        && data.keys().hasOnly(['chequeId','amount'])
        && id(data.chequeId) && positiveMoney(data.amount);
    }
    function chequeAllocationAt(list, index) { return list.size() <= index || validChequeAllocation(list[index]); }
    function validAllocation(data) {
      return data is map
        && data.keys().hasAll(['invoiceId','cash','chequeAmounts'])
        && data.keys().hasOnly(['invoiceId','cash','chequeAmounts'])
        && id(data.invoiceId) && money(data.cash)
        && data.chequeAmounts is list && data.chequeAmounts.size() <= 5
        && chequeAllocationAt(data.chequeAmounts, 0)
        && chequeAllocationAt(data.chequeAmounts, 1)
        && chequeAllocationAt(data.chequeAmounts, 2)
        && chequeAllocationAt(data.chequeAmounts, 3)
        && chequeAllocationAt(data.chequeAmounts, 4);
    }
    function allocationAt(list, index) { return list.size() <= index || validAllocation(list[index]); }
    function validAllocations(value) {
      return value is list && value.size() >= 1 && value.size() <= 10
        && allocationAt(value, 0) && allocationAt(value, 1) && allocationAt(value, 2)
        && allocationAt(value, 3) && allocationAt(value, 4) && allocationAt(value, 5)
        && allocationAt(value, 6) && allocationAt(value, 7) && allocationAt(value, 8)
        && allocationAt(value, 9);
    }
    function baseKeys() {
      return ['id','kind','date','createdAt','operatorId','deviceId','shopId',
        'authUid','serverSequence','disposition','conflictReason'];
    }
    function validBase(data, eventId) {
      return data.keys().hasAll(['id','kind','date','createdAt','operatorId','deviceId',
          'shopId','authUid','serverSequence','disposition'])
        && data.id == eventId && id(data.id) && id(data.deviceId)
        && (data.kind == 'daily-sales' ? data.shopId == '' : id(data.shopId))
        && data.authUid == request.auth.uid
        && day(data.date) && instant(data.createdAt)
        && data.operatorId in ['me','brother']
        && data.disposition in ['applied','conflict']
        && (data.disposition != 'conflict' || ('conflictReason' in data && text(data.conflictReason, 1, 1000)))
        && optionalText(data, 'conflictReason', 1000)
        && data.serverSequence is int && data.serverSequence > 0;
    }
    function validInvoice(data) {
      return data.keys().hasOnly(baseKeys().concat(['reference','total','cash','cheques','dueDate','photoIds']))
        && data.keys().hasAll(['reference','total','cash','cheques','photoIds'])
        && text(data.reference, 1, 120) && positiveMoney(data.total) && money(data.cash)
        && validCheques(data.cheques) && photoIds(data.photoIds)
        && (!('dueDate' in data) || day(data.dueDate));
    }
    function validCollection(data) {
      return data.keys().hasOnly(baseKeys().concat(['cash','cheques','allocations','photoIds']))
        && data.keys().hasAll(['cash','cheques','allocations','photoIds'])
        && money(data.cash) && validCheques(data.cheques)
        && validAllocations(data.allocations) && photoIds(data.photoIds);
    }
    function validChequeStatus(data) {
      return data.keys().hasOnly(baseKeys().concat(['chequeId','status']))
        && data.keys().hasAll(['chequeId','status'])
        && id(data.chequeId) && data.status in ['deposited','cleared','returned'];
    }
    function validCorrection(data) {
      return data.keys().hasOnly(baseKeys().concat(['targetId','reason','total','cash']))
        && data.keys().hasAll(['targetId','reason','total','cash'])
        && id(data.targetId) && text(data.reason, 1, 1000)
        && positiveMoney(data.total) && money(data.cash);
    }
    // A whole-day sales revision is an immutable event without a shop.
    function validDailySales(data) {
      return data.keys().hasOnly(baseKeys().concat(['total','previousId']))
        && data.keys().hasAll(['total','previousId'])
        && data.operatorId == 'me' && money(data.total)
        && (data.previousId == '' || id(data.previousId));
    }
    function validEvent(data, eventId) {
      return validBase(data, eventId)
        && ((data.kind == 'invoice' && validInvoice(data))
          || (data.kind == 'collection' && validCollection(data))
          || (data.kind == 'cheque-status' && validChequeStatus(data))
          || (data.kind == 'correction' && validCorrection(data))
          || (data.kind == 'daily-sales' && validDailySales(data)));
    }
    function appendMatchesHead(agency, data) {
      let before = get(/databases/$(database)/documents/agencies/$(agency)/sync/head).data;
      let after = getAfter(/databases/$(database)/documents/agencies/$(agency)/sync/head).data;
      return data.serverSequence == before.sequence + 1
        && after.sequence == data.serverSequence && after.lastEventId == data.id;
    }
    function validHead(agency, data) {
      let event = getAfter(/databases/$(database)/documents/agencies/$(agency)/events/$(data.lastEventId)).data;
      return data.keys().hasAll(['sequence','lastEventId'])
        && data.keys().hasOnly(['sequence','lastEventId'])
        && data.sequence is int && data.sequence == resource.data.sequence + 1
        && id(data.lastEventId)
        && !exists(/databases/$(database)/documents/agencies/$(agency)/events/$(data.lastEventId))
        && event.serverSequence == data.sequence && event.authUid == request.auth.uid;
    }

    function validShop(data, shopId) {
      return data.keys().hasAll(['id','name','authUid','updatedAt'])
        && data.keys().hasOnly(['id','name','contact','phone','village','route','latitude',
          'longitude','photoIds','notes','createdAt','authUid','updatedAt'])
        && data.id == shopId && id(data.id) && text(data.name, 1, 120)
        && data.authUid == request.auth.uid && instant(data.updatedAt)
        && optionalText(data, 'contact', 120) && optionalText(data, 'phone', 40)
        && optionalText(data, 'village', 120) && optionalText(data, 'route', 120)
        && optionalText(data, 'notes', 2000)
        && (!('createdAt' in data) || instant(data.createdAt))
        && (!('photoIds' in data) || photoIds(data.photoIds))
        && (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && (('latitude' in data) == ('longitude' in data));
    }
    function validFigures(data) {
      return data is map
        && data.keys().hasAll(['invoiceValue','newCredit','cashFromInvoices','cashFromCollections',
          'expectedCash','chequesReceived','chequesDeposited','chequesCleared','chequesReturned'])
        && data.keys().hasOnly(['invoiceValue','newCredit','cashFromInvoices','cashFromCollections',
          'expectedCash','chequesReceived','chequesDeposited','chequesCleared','chequesReturned'])
        && money(data.invoiceValue) && money(data.newCredit) && money(data.cashFromInvoices)
        && money(data.cashFromCollections) && money(data.expectedCash)
        && data.expectedCash == data.cashFromInvoices + data.cashFromCollections
        && money(data.chequesReceived) && money(data.chequesDeposited)
        && money(data.chequesCleared) && money(data.chequesReturned);
    }
    function validClose(data, closeId) {
      return data.keys().hasAll(['id','date','createdAt','operatorId','deviceId','countedCash','snapshot','authUid'])
        && data.keys().hasOnly(['id','date','createdAt','operatorId','deviceId','countedCash',
          'snapshot','route','filterOperatorId','note','authUid'])
        && data.id == closeId && id(data.id) && id(data.deviceId)
        && data.authUid == request.auth.uid
        && day(data.date) && instant(data.createdAt) && data.operatorId in ['me','brother']
        && money(data.countedCash) && validFigures(data.snapshot)
        && optionalText(data, 'route', 120) && optionalText(data, 'note', 2000)
        && (!('filterOperatorId' in data) || data.filterOperatorId in ['me','brother']);
    }

    match /agencies/{agency} {
      allow read: if enrolled(agency);
      allow write: if false;
      match /devices/{uid} {
        // Read own membership for enrolment and revocation detection only.
        allow get: if signedIn() && request.auth.uid == uid
          && (request.auth.token.get('agencyId', '') == agency || anonymousDevice());
        allow create: if signedIn() && request.auth.uid == uid
          && validPinMembership(request.resource.data)
          && validPinClaim(agency, uid, get(pinStatePath(agency)).data, getAfter(pinStatePath(agency)).data);
        allow list, update, delete: if false;
      }
      match /setup/window {
        allow get: if signedIn();
        allow create, update: if enrolled(agency) && validPinWindow(request.resource.data)
          && validNewPinState(getAfter(pinStatePath(agency)).data, request.resource.data.id);
        allow list, delete: if false;
      }
      match /setup/pinState {
        allow read, delete: if false;
        allow create, update: if enrolled(agency)
          && validPinWindow(getAfter(pinWindowPath(agency)).data)
          && validNewPinState(request.resource.data, getAfter(pinWindowPath(agency)).data.id);
        allow update: if validNewPinAttempt(agency, resource.data, request.resource.data)
          || (signedIn() && !exists(devicePath(agency, request.auth.uid))
            && validPinClaim(agency, request.auth.uid, resource.data, request.resource.data)
            && validPinMembership(getAfter(devicePath(agency, request.auth.uid)).data));
      }
      match /setupAttempts/{uid} {
        allow read: if false;
        allow create, update: if anonymousDevice() && request.auth.uid == uid
          && attemptMatchesCounter(agency, uid, request.resource.data);
        allow delete: if anonymousDevice() && request.auth.uid == uid;
      }
      match /events/{eventId} {
        allow read: if enrolled(agency);
        allow create: if enrolled(agency) && validEvent(request.resource.data, eventId)
          && appendMatchesHead(agency, request.resource.data);
        allow update, delete: if false;
      }
      match /sync/head {
        allow read: if enrolled(agency);
        allow update: if enrolled(agency) && validHead(agency, request.resource.data);
        allow create, delete: if false;
      }
      match /shops/{shopId} {
        allow read: if enrolled(agency);
        allow create: if enrolled(agency) && validShop(request.resource.data, shopId);
        allow update: if enrolled(agency) && validShop(request.resource.data, shopId)
          && request.resource.data.id == resource.data.id
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if false;
      }
      match /closes/{closeId} {
        allow read: if enrolled(agency);
        allow create: if enrolled(agency) && validClose(request.resource.data, closeId);
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
